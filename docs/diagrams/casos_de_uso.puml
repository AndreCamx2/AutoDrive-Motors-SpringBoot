@startuml casos_de_uso
title AutoDrive Motors - Diagrama de Casos de Uso

left to right direction
skinparam packageStyle rectangle
skinparam actorStyle awesome
skinparam usecase {
  BackgroundColor #F5F9FF
  BorderColor #2B6CB0
}

actor "Asesor Comercial" as Asesor
actor "Técnico de Taller" as Tecnico
actor "Administrador" as Admin
actor "API Tasa de Cambio\n(Sistema externo)" as ApiFx <<system>>

Admin --|> Asesor
Admin --|> Tecnico

rectangle "Sistema AutoDrive Motors" {

  package "Clientes" {
    usecase "Registrar cliente" as UC_C1
    usecase "Consultar clientes" as UC_C2
    usecase "Consultar cliente por ID" as UC_C3
    usecase "Actualizar cliente" as UC_C4
    usecase "Eliminar cliente" as UC_C5
    usecase "Validar email y cédula únicos" as UC_C6
  }

  package "Vehículos" {
    usecase "Registrar vehículo" as UC_V1
    usecase "Consultar vehículos" as UC_V2
    usecase "Buscar por marca" as UC_V3
    usecase "Buscar por estado" as UC_V4
    usecase "Actualizar vehículo" as UC_V5
    usecase "Eliminar vehículo" as UC_V6
    usecase "Validar placa única\ny precio positivo" as UC_V7
    usecase "Consultar precio en USD" as UC_V8
  }

  package "Ventas" {
    usecase "Registrar venta" as UC_S1
    usecase "Consultar ventas" as UC_S2
    usecase "Consultar ventas por cliente" as UC_S3
    usecase "Validar disponibilidad\ndel vehículo" as UC_S4
    usecase "Aplicar descuento 5%\n(precio > 100.000.000 COP)" as UC_S5
    usecase "Cambiar estado a VENDIDO" as UC_S6
    usecase "Convertir total a USD" as UC_S7
  }

  package "Mantenimientos" {
    usecase "Registrar mantenimiento" as UC_M1
    usecase "Finalizar mantenimiento" as UC_M2
    usecase "Consultar historial\npor vehículo" as UC_M3
    usecase "Cambiar estado a\nEN_MANTENIMIENTO / DISPONIBLE" as UC_M4
  }
}

' --- Clientes
Asesor --> UC_C1
Asesor --> UC_C2
Asesor --> UC_C3
Asesor --> UC_C4
Admin --> UC_C5
UC_C1 ..> UC_C6 : <<include>>
UC_C4 ..> UC_C6 : <<include>>

' --- Vehículos
Admin --> UC_V1
Asesor --> UC_V2
Asesor --> UC_V3
Asesor --> UC_V4
Admin --> UC_V5
Admin --> UC_V6
Asesor --> UC_V8
UC_V1 ..> UC_V7 : <<include>>
UC_V5 ..> UC_V7 : <<include>>
UC_V8 --> ApiFx

' --- Ventas
Asesor --> UC_S1
Asesor --> UC_S2
Asesor --> UC_S3
UC_S1 ..> UC_S4 : <<include>>
UC_S1 ..> UC_S6 : <<include>>
UC_S5 ..> UC_S1 : <<extend>>
UC_S7 ..> UC_S1 : <<extend>>
UC_S7 --> ApiFx

' --- Mantenimientos
Tecnico --> UC_M1
Tecnico --> UC_M2
Tecnico --> UC_M3
UC_M1 ..> UC_M4 : <<include>>
UC_M2 ..> UC_M4 : <<include>>

note right of UC_S4
  No se permite vender vehículos
  en estado VENDIDO o EN_MANTENIMIENTO
end note

@enduml

