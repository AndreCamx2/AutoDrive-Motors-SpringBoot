@startuml modelo_er
title AutoDrive Motors - Modelo entidad-relación (PostgreSQL)

skinparam shadowing false
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam linetype ortho
skinparam ArrowColor #2B4C7E
skinparam ClassBorderColor #2B4C7E
skinparam ClassBackgroundColor #FFFFFF
skinparam ClassHeaderBackgroundColor #F8F9FA
skinparam NoteBorderColor #8A94A6
skinparam NoteBackgroundColor #F8F9FA
hide circle

entity "clientes" as clientes {
  * id : BIGINT <<PK>>
  --
  * cedula : VARCHAR(20) <<UK>>
  * nombre : VARCHAR(100)
  * apellido : VARCHAR(100)
  * email : VARCHAR(150) <<UK>>
  telefono : VARCHAR(25)
  direccion : VARCHAR(255)
  * fecha_registro : TIMESTAMP
}

entity "vehiculos" as vehiculos {
  * id : BIGINT <<PK>>
  --
  * placa : VARCHAR(10) <<UK>>
  * marca : VARCHAR(60)
  * modelo : VARCHAR(60)
  * anio : INTEGER
  * color : VARCHAR(40)
  * precio : NUMERIC(14,2)
  * estado : VARCHAR(25)
  * fecha_creacion : TIMESTAMP
}

entity "ventas" as ventas {
  * id : BIGINT <<PK>>
  --
  * cliente_id : BIGINT <<FK>>
  * vehiculo_id : BIGINT <<FK>> <<UK>>
  * fecha_venta : TIMESTAMP
  * precio_base : NUMERIC(14,2)
  porcentaje_descuento : NUMERIC(5,2)
  * monto_descuento : NUMERIC(14,2)
  * total_pagado : NUMERIC(14,2)
  observaciones : TEXT
}

entity "mantenimientos" as mantenimientos {
  * id : BIGINT <<PK>>
  --
  * vehiculo_id : BIGINT <<FK>>
  * fecha_ingreso : TIMESTAMP
  fecha_salida : TIMESTAMP
  * tipo : VARCHAR(20)
  * estado : VARCHAR(20)
  * costo : NUMERIC(14,2)
  * descripcion : TEXT
}

clientes ||--o{ ventas : fk_ventas_cliente
vehiculos ||--o| ventas : fk_ventas_vehiculo
vehiculos ||--o{ mantenimientos : fk_mantenimientos_vehiculo

note bottom of vehiculos
  estado: DISPONIBLE | VENDIDO | EN_MANTENIMIENTO
end note

@enduml
