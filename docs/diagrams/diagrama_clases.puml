@startuml diagrama_clases
title AutoDrive Motors - Modelo de dominio

skinparam shadowing false
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam classAttributeIconSize 0
skinparam ArrowColor #2B4C7E
skinparam ClassBorderColor #2B4C7E
skinparam ClassBackgroundColor #FFFFFF
skinparam ClassHeaderBackgroundColor #F8F9FA
skinparam NoteBorderColor #8A94A6
skinparam NoteBackgroundColor #F8F9FA
hide circle

class Cliente {
  - id : Long
  - cedula : String
  - nombre : String
  - apellido : String
  - email : String
  - telefono : String
  - direccion : String
  - fechaRegistro : LocalDateTime
  - ventas : List<Venta>
  --
  + getNombreCompleto() : String
}

class Vehiculo {
  - id : Long
  - placa : String
  - marca : String
  - modelo : String
  - anio : Integer
  - color : String
  - precio : BigDecimal
  - estado : EstadoVehiculo
  - fechaCreacion : LocalDateTime
  - mantenimientos : List<Mantenimiento>
  - venta : Venta
  --
  + estaDisponibleParaVenta() : boolean
  + marcarComoVendido() : void
  + enviarAMantenimiento() : void
  + marcarComoDisponible() : void
}

class Venta {
  - id : Long
  - cliente : Cliente
  - vehiculo : Vehiculo
  - fechaVenta : LocalDateTime
  - precioBase : BigDecimal
  - porcentajeDescuento : BigDecimal
  - montoDescuento : BigDecimal
  - totalPagado : BigDecimal
  - observaciones : String
}

class Mantenimiento {
  - id : Long
  - vehiculo : Vehiculo
  - fechaIngreso : LocalDateTime
  - fechaSalida : LocalDateTime
  - tipo : TipoMantenimiento
  - estado : EstadoMantenimiento
  - costo : BigDecimal
  - descripcion : String
  --
  + finalizar() : void
}

enum EstadoVehiculo {
  DISPONIBLE
  VENDIDO
  EN_MANTENIMIENTO
  --
  + permiteVenta() : boolean
}

Cliente "1" -- "0..*" Venta : realiza >
Vehiculo "1" -- "0..1" Venta : se vende en >
Vehiculo "1" -- "0..*" Mantenimiento : registra >
Vehiculo --> "1" EstadoVehiculo : estado

note bottom of Venta
  Si precioBase > 100.000.000 COP:
  porcentajeDescuento = 5
  totalPagado = precioBase - montoDescuento
end note

@enduml
