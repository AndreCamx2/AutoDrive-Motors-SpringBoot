@startuml diagrama_secuencia_venta
title Registro de venta - POST /ventas

autonumber
hide footbox
skinparam shadowing false
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam ArrowColor #2B4C7E
skinparam SequenceLifeLineBorderColor #8A94A6
skinparam ParticipantBorderColor #2B4C7E
skinparam ParticipantBackgroundColor #F8F9FA
skinparam ActorBorderColor #2B4C7E
skinparam ActorBackgroundColor #FFFFFF
skinparam DatabaseBorderColor #2B4C7E
skinparam DatabaseBackgroundColor #F8F9FA
skinparam SequenceGroupBorderColor #8A94A6
skinparam SequenceGroupBackgroundColor #F8F9FA
skinparam NoteBorderColor #8A94A6
skinparam NoteBackgroundColor #FFFFFF

actor Usuario
participant VentaController
participant VentaService
database ClienteRepository
database VehiculoRepository
database VentaRepository
participant CurrencyExchangeService
participant ExchangeRateClient

Usuario -> VentaController : POST /ventas {clienteId, vehiculoId}
VentaController -> VentaService : registrarVenta(dto)

VentaService -> ClienteRepository : findById(clienteId)
ClienteRepository --> VentaService : cliente

VentaService -> VehiculoRepository : findByIdForUpdate(vehiculoId)
VehiculoRepository --> VentaService : vehiculo

VentaService -> VentaService : vehiculo.estaDisponibleParaVenta()

alt vehículo no DISPONIBLE (VENDIDO o EN_MANTENIMIENTO)
  VentaService --> VentaController : BusinessRuleException
  VentaController --> Usuario : 409 Conflict
else vehículo DISPONIBLE
  VentaService -> VentaService : precioBase = vehiculo.precio

  opt precioBase > 100.000.000 COP
    VentaService -> VentaService : montoDescuento = precioBase * 5%
  end

  VentaService -> VentaService : totalPagado = precioBase - montoDescuento
  VentaService -> VentaService : vehiculo.marcarComoVendido()
  VentaService -> VentaRepository : save(venta)
  VentaRepository --> VentaService : venta (fechaVenta asignada)

  VentaService -> CurrencyExchangeService : convertirCopAUsd(totalPagado)
  opt tasa no disponible en caché
    CurrencyExchangeService -> ExchangeRateClient : getLatestRates()
    ExchangeRateClient --> CurrencyExchangeService : tasa COP -> USD
  end
  CurrencyExchangeService --> VentaService : ConversionUsdDTO

  VentaService --> VentaController : VentaResponseDTO
  VentaController --> Usuario : 201 Created
end

note over VentaController, VentaRepository
  Si el cliente o el vehículo no existen
  se lanza ResourceNotFoundException (404).
end note

@enduml
