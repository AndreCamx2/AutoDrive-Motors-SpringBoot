              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "http://localhost:8080/clientes",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["clientes"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cedula\": \"1234567890\",\n  \"nombre\": \"Juan\",\n  \"apellido\": \"Perez\",\n  \"email\": \"juan.perez@email.com\",\n  \"telefono\": \"3001234567\",\n  \"direccion\": \"Calle Falsa 123\"\n}"
